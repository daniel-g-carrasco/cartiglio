; Inno Setup script for Cartiglio.
; Compiled by CI with:  ISCC.exe /DAppVersion=X.Y.Z installer\cartiglio.iss
; Expects the PyInstaller output in dist\cartiglio (repo root).
;
; The registry layout below mirrors win_register() in cartiglio.py
; (verb Cartiglio.redate, on PDF files and on folders): keep them in sync.
; Every user-visible string lives in [CustomMessages], once per language.

#ifndef AppVersion
  #define AppVersion "dev"
#endif

[Setup]
AppId={{C3C58021-E93C-4493-BC99-DCCB5F6DAE13}
AppName=Cartiglio
AppVersion={#AppVersion}
AppPublisher=Daniel Grasso
AppPublisherURL=https://github.com/daniel-g-carrasco/cartiglio
AppSupportURL=https://github.com/daniel-g-carrasco/cartiglio/issues
AppUpdatesURL=https://github.com/daniel-g-carrasco/cartiglio/releases
DefaultDirName={autopf}\Cartiglio
DefaultGroupName=Cartiglio
DisableProgramGroupPage=yes
LicenseFile=..\LICENSE
; per-user install by default (no UAC); the dialog (or /ALLUSERS, /CURRENTUSER
; on the command line) lets the user choose
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog commandline
OutputBaseFilename=cartiglio-setup-v{#AppVersion}-windows-x64
SetupIconFile=..\assets\icon.ico
UninstallDisplayIcon={app}\cartiglio.exe
; app icon in the wizard, one bitmap per DPI scale (generated by tools/make_icon.py)
WizardSmallImageFile=wizard-small-*.bmp
WizardImageFile=wizard-large-*.bmp
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ChangesAssociations=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; upgrades: close the running app instead of failing on files in use
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
italian.TaskContextMenu=Aggiungi «Cambia le date del cartiglio con Cartiglio» al menu contestuale di file PDF e cartelle
english.TaskContextMenu=Add "Change title block dates with Cartiglio" to the context menu of PDF files and folders
italian.VerbRedate=Cambia le date del cartiglio con Cartiglio
english.VerbRedate=Change title block dates with Cartiglio

[Tasks]
Name: "contextmenu"; Description: "{cm:TaskContextMenu}"
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; Flags: unchecked

[Files]
Source: "..\dist\cartiglio\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\Cartiglio"; Filename: "{app}\cartiglio.exe"
Name: "{autodesktop}\Cartiglio"; Filename: "{app}\cartiglio.exe"; Tasks: desktopicon

[Registry]
; --- context-menu verb on every PDF, whatever the default app is, and on
;     folders (a whole delivery is re-dated at once). Nothing else is
;     registered: this tool is not a PDF viewer.
;     MultiSelectModel=Player: Explorer runs it for each selected item with
;     no "too many files" prompt; the app merges them into its single window.
Root: HKA; Subkey: "Software\Classes\SystemFileAssociations\.pdf\shell\Cartiglio.redate"; ValueType: string; ValueName: ""; ValueData: "{cm:VerbRedate}"; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\SystemFileAssociations\.pdf\shell\Cartiglio.redate"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\cartiglio.exe,0"; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\SystemFileAssociations\.pdf\shell\Cartiglio.redate"; ValueType: string; ValueName: "MultiSelectModel"; ValueData: "Player"; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\SystemFileAssociations\.pdf\shell\Cartiglio.redate\command"; ValueType: string; ValueName: ""; ValueData: """{app}\cartiglio.exe"" --gui ""%1"""; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\Directory\shell\Cartiglio.redate"; ValueType: string; ValueName: ""; ValueData: "{cm:VerbRedate}"; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\Directory\shell\Cartiglio.redate"; ValueType: string; ValueName: "Icon"; ValueData: "{app}\cartiglio.exe,0"; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\Directory\shell\Cartiglio.redate"; ValueType: string; ValueName: "MultiSelectModel"; ValueData: "Player"; Tasks: contextmenu
Root: HKA; Subkey: "Software\Classes\Directory\shell\Cartiglio.redate\command"; ValueType: string; ValueName: ""; ValueData: """{app}\cartiglio.exe"" --gui ""%1"""; Tasks: contextmenu

[INI]
; the language chosen for Setup becomes the app language. {localappdata} is
; the profile of the user running Setup (with UAC approval that is still the
; same user; only elevation with another administrator's account would land
; the setting in that other profile, which is harmless).
Filename: "{localappdata}\cartiglio\settings.ini"; Section: "general"; Key: "language"; String: "{code:AppLanguage}"

[UninstallDelete]
Type: filesandordirs; Name: "{localappdata}\cartiglio"

[UninstallRun]
; the app may have added its context-menu entry per-user from its Preferences: clean that up too
Filename: "{app}\cartiglio.exe"; Parameters: "--unregister"; RunOnceId: "UnregisterShell"; Flags: runhidden

[Run]
Filename: "{app}\cartiglio.exe"; Description: "{cm:LaunchProgram,Cartiglio}"; Flags: nowait postinstall skipifsilent

[Code]
function AppLanguage(Param: String): String;
begin
  if ActiveLanguage = 'italian' then
    Result := 'it'
  else
    Result := 'en';
end;
